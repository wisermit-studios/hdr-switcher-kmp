using System.CommandLine;
using SystemManager.Util;

namespace SystemManager;

public static class Program
{
    static void Main(string[] args)
    {
        CommandLine commandLine = [];
        ParseResult parseResult = commandLine.Parse(args);

        try
        {
            VerbosityOption.Level level = parseResult.GetRequiredValue(commandLine.VerbosityOption);
            Log.Level = level.Loglevel;
        }
        catch { }

        Log.I($"log level: {Log.Level}");
        Log.I($"errors: {parseResult.Errors.Count}");

        // Check error.

        SetupHdrActions(commandLine.HdrCommand);
        SetupLaunchAction(commandLine.LaunchCommand);
        SetupServiceAction(commandLine.ServiceCommand);

        int result = parseResult.Invoke();
        Environment.Exit(result);
    }

    private static void SetupHdrActions(HdrCommand command)
    {
        command.StatusCommand.SetAction(parseResult =>
        {
            Log.D("HDR Status");
            return 0;
        });

        command.EnableCommand.SetAction(parseResult =>
        {
            Log.D("Enabled HDR");
            return 0;
        });

        command.DisableCommand.SetAction(parseResult =>
        {
            Log.D("Disable HDR");
            return 0;
        });
    }

    private static void SetupLaunchAction(LaunchCommand command)
    {
        command.SetAction(parseResult =>
        {
            string? path = parseResult.GetValue(command.PathArgument);
            Log.D($"Launch an application: {path}");
            return 0;
        });
    }

    private static void SetupServiceAction(ServiceCommand command)
    {
        command.StartCommand.SetAction(parseResult =>
        {
            Log.D($"Start service");
            return 0;
        });
    }
}